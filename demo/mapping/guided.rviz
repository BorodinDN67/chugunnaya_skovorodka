Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Guided demo map
      Enabled: true
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Topic:
        Value: /kiss/guided/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: KISS-ICP with Unitree odometry
      Enabled: true
      Color: 255; 90; 25
      Line Style: Billboards
      Line Width: 0.08
      Topic:
        Value: /kiss/guided/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 30; 30; 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: -1.5707963
      Scale: 29
      X: 0.5
      Y: 8
      Target Frame: odom
Window Geometry:
  Width: 1280
  Height: 800
